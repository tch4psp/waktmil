# Safe development examples only. Production secrets must use read-only *_FILE paths.
NODE_ENV=development
RUNTIME_ROLE=web
APP_BASE_URL=http://localhost:3000
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=tempmail
DATABASE_USER=tempmail_app
DATABASE_PASSWORD_FILE=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX_WEB=10

MAILBOX_TTL_MINUTES=60
MAILBOX_ALIAS_BYTES=10
ACCESS_TOKEN_BYTES=32
IP_HMAC_KEY_FILE=
PUBLIC_MAILBOX_CREATION_ENABLED=true

# Shared only with the Cloudflare Worker secret of the same name. Use a generated
# 32+ character value; never commit a production value.
EMAIL_INGEST_SECRET=
EMAIL_INGEST_MAX_MESSAGE_BYTES=10485760
EMAIL_INGEST_MAX_AGE_SECONDS=300
EMAIL_INGEST_MAX_FUTURE_SKEW_SECONDS=30

MAX_TEXT_BODY_BYTES=2097152
MAX_HTML_BODY_BYTES=2097152
MAX_ATTACHMENTS_PER_MESSAGE=5
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENTS_TOTAL_BYTES=8388608
MAX_MESSAGES_PER_MAILBOX=100
MAX_MAILBOX_ATTACHMENT_BYTES=104857600
ATTACHMENT_ROOT=./data/attachments
TEMP_ROOT=./data/tmp

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000
CLAMAV_MAX_CONCURRENCY=2

ADMIN_SESSION_COOKIE_NAME=tm_admin
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_BOOTSTRAP_PASSWORD_FILE=
ADMIN_BOOTSTRAP_USERNAME=

METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=1000
DISK_WARNING_PERCENT=75
DISK_PROTECT_PERCENT=85
DISK_CRITICAL_PERCENT=92
