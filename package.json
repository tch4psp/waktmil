{
  "name": "temporary-email-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Secure temporary inbound email service",
  "main": "src/web/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/web/server.js",
    "worker:dev": "wrangler dev --config workers/email-ingest/wrangler.jsonc --local",
    "worker:deploy": "wrangler deploy --config workers/email-ingest/wrangler.jsonc",
    "start:cleanup": "node src/workers/cleanup.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "backup:durable": "node scripts/export-durable-config.js",
    "restore:durable": "node scripts/restore-durable-config.js",
    "check-config": "node scripts/check-config.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "lint": "eslint .",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:worker": "node --test --test-concurrency=1 tests/worker/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mailparser": "^3.9.15",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "wrangler": "4.123.0"
  }
}
